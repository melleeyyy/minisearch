name: Keep Search API awake

# DISABLED: renamed to *.disabled so GitHub Actions never runs this
# workflow. Rename back to keepalive.yml to re-enable.
#
# Render's free tier spins a service down after 15 minutes without
# inbound traffic. This workflow pings the /health endpoint every 5
# minutes (GitHub Actions' minimum schedule interval) so the MiniSearch
# API stays awake around the clock, at no cost (public repo).
#
# Note: GitHub disables scheduled workflows after 60 days of repo
# inactivity — any push (including the CI's own data commits) resets
# that timer.

on:
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: keepalive
  cancel-in-progress: true

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping the API health endpoint
        run: |
          # max-time 120: if the service is spinning up (~50s), wait for it
          code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 120 \
            https://minisearch-api.onrender.com/health)
          echo "health status: $code"
          if [ "$code" != "200" ]; then
            echo "first ping did not return 200; retrying once after a pause"
            sleep 60
            code2=$(curl -s -o /dev/null -w "%{http_code}" --max-time 120 \
              https://minisearch-api.onrender.com/health)
            echo "retry status: $code2"
          fi
          # never fail the workflow — it is just a keep-alive ping
          exit 0
